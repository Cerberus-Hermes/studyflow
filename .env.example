# Supabase Configuration
# Get from: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Kimi API Configuration
# Get your key from: https://platform.moonshot.cn/ or https://openrouter.ai/
KIMI_API_KEY=sk-your-key-here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Auth Configuration
# Generate a random secret (min 16 chars): openssl rand -hex 32
AUTH_SECRET=your-random-secret-here

# Admin Configuration
# Registrations with this email get admin role
ADMIN_EMAIL=admin@studyflow.local

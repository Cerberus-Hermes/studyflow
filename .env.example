# Kimi API Configuration
# Get your key from: https://platform.moonshot.cn/ or https://platform.moonshot.ai/
KIMI_API_KEY=sk-your-key-here
# Use .ai for international keys, .cn for China platform keys
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.6

# Auth (required for login, feedback, admin settings)
AUTH_SECRET=change-me-to-a-long-random-string-min-16-chars
ADMIN_PASSWORD=your-admin-password-here
# Optional: auto-promote this email to admin on register
# ADMIN_EMAIL=admin@example.com
